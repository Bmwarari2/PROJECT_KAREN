  "rules": [
    {
      "key": "leave.statutory_annual_minimum",
      "description": "Zákoník práce § 213(1): annual leave of at least 4 weeks per calendar year (5 weeks for public-sector employers under § 109(3))",
      "versions": [
        {
          "effectiveFrom": "2026-01-01",
          "effectiveTo": null,
          "value": {
            "weeks": 4,
            "perCalendarYear": true,
            "publicSectorWeeks": 5
          },
          "source": {
            "url": "https://www.zakonyprolidi.cz/cs/2006-262",
            "title": "Zákon č. 262/2006 Sb., zákoník práce, § 213 (výměra dovolené)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "§ 213: \"Výměra dovolené činí nejméně 4 týdny v kalendářním roce\"; employees of employers under § 109(3) (public sector): 5 weeks. Hours-based leave calculation (since 2021) not modelled. Verified as the law in force on the verification date; historical effective date not researched, so effectiveFrom is set to 2026-01-01 (earlier dates resolve to the parent/none)."
        }
      ]
    },
    {
      "key": "reporting.pay_transparency",
      "description": "National transposition status of the EU Pay Transparency Directive (EU) 2023/970",
      "versions": [
        {
          "effectiveFrom": "2026-06-07",
          "effectiveTo": null,
          "value": {
            "status": "partially_transposed",
            "law": "Existing legislation notified (65 measures, latest Act No. 314/2025 Coll.); dedicated Labour Code amendment not yet adopted",
            "inForceFrom": null
          },
          "source": {
            "url": "https://eur-lex.europa.eu/legal-content/EN/NIM/?uri=CELEX:32023L0970",
            "title": "EUR-Lex: national transposition measures communicated for Directive (EU) 2023/970"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "EUR-Lex lists 65 Czech measures (latest 2025-09-02), i.e. existing law notified as partial transposition. Press reports a Labour Code amendment draft (March 2026) targeting 1 January 2027 — not verified on an official Czech site."
        }
      ]
    }
  ],
