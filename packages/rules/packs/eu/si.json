  "rules": [
    {
      "key": "leave.statutory_annual_minimum",
      "description": "Minimum annual leave (ZDR-1, 159. člen)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "weeks": 4,
            "fiveDayWeekDays": 20,
            "additionalStatutoryDaysForCategories": true
          },
          "source": {
            "url": "https://www.gov.si/assets/ministrstva/MDDSZ/Delovna-razmerja/Letni-dopust-in-regres.pdf",
            "title": "MDDSZ (GOV.SI): Letni dopust in regres — ZDR-1, 159. člen"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "At least four weeks regardless of full- or part-time; day count depends on the weekly schedule (5-day week = at least 20 days). Additional days for older workers, disabled workers etc. (159. člen (3)–(4)) not modelled."
        }
      ]
    },
    {
      "key": "reporting.pay_transparency",
      "description": "EU Pay Transparency Directive (EU) 2023/970 — national transposition status (as verified 2026-10-18)",
      "versions": [
        {
          "effectiveFrom": "2023-06-06",
          "effectiveTo": null,
          "value": {
            "status": "not_transposed",
            "law": null,
            "inForceFrom": null
          },
          "source": {
            "url": "https://eur-lex.europa.eu/legal-content/EN/NIM/?uri=CELEX:32023L0970",
            "title": "EUR-Lex: National transposition measures communicated by the Member States concerning Directive (EU) 2023/970"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Status as at 2026-10-18 from the EUR-Lex national-transposition-measures list (the Commission records notifications; it does not certify completeness). Slovenia notified only pre-existing measures (ZDR-1, ZVarD, etc.); no dedicated act adopted. Secondary sources report a draft act in 2026."
        }
      ]
    }
