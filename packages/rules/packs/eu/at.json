  "rules": [
    {
      "key": "leave.statutory_annual_minimum",
      "description": "Urlaubsgesetz § 2: 30 Werktage on a 6-day week (25 Arbeitstage on a 5-day week); 36 Werktage / 30 Arbeitstage after more than 25 years of service",
      "versions": [
        {
          "effectiveFrom": "2026-01-01",
          "effectiveTo": null,
          "value": {
            "days": 30,
            "dayUnit": "werktage",
            "weekBasisDays": 6,
            "fiveDayWeekEquivalentDays": 25,
            "weeks": 5,
            "extended": {
              "afterServiceYears": 25,
              "days": 36,
              "fiveDayWeekEquivalentDays": 30,
              "weeks": 6
            }
          },
          "source": {
            "url": "https://www.usp.gv.at/themen/mitarbeiter-und-gesundheit/urlaub-und-arbeitszeit/urlaub.html",
            "title": "Unternehmensserviceportal (USP): Urlaub (Urlaubsgesetz § 2)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "USP: \"30 Werktagen bei einer Sechs-Tage-Woche (bzw. 25 Arbeitstagen bei einer Fünf-Tage-Woche)\"; more than 25 years at the same company: 36 Werktage / 30 Arbeitstage. ris.bka.gv.at returned 503 during verification. Verified as the law in force on the verification date; historical effective date not researched, so effectiveFrom is set to 2026-01-01 (earlier dates resolve to the parent/none)."
        }
      ]
    },
    {
      "key": "reporting.pay_transparency",
      "description": "National transposition status of the EU Pay Transparency Directive (EU) 2023/970",
      "versions": [
        {
          "effectiveFrom": "2026-06-07",
          "effectiveTo": null,
          "value": {
            "status": "partially_transposed",
            "law": "Only Land-level public-service laws notified (Styria, Burgenland, Lower Austria); no federal private-sector transposition act",
            "inForceFrom": null
          },
          "source": {
            "url": "https://eur-lex.europa.eu/legal-content/EN/NIM/?uri=CELEX:32023L0970",
            "title": "EUR-Lex: national transposition measures communicated for Directive (EU) 2023/970"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "EUR-Lex lists 30 Austrian measures, all Land public-service/equal-treatment laws (latest Burgenland 2026-09-30). No federal law covering private employers had been notified as of 2026-10-18."
        }
      ]
    }
  ],
