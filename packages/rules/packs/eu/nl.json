  "rules": [
    {
      "key": "leave.statutory_annual_minimum",
      "description": "Statutory annual leave (BW 7:634)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "multipleOfWeeklyHours": 4,
            "basis": "agreed_weekly_working_hours",
            "proRataForPartYear": true
          },
          "source": {
            "url": "https://wetten.overheid.nl/BWBR0005290/2026-01-01",
            "title": "Burgerlijk Wetboek Boek 7 (wetten.overheid.nl), versie 2026-01-01 — art. 7:629, 7:634, 7:672"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "At least four times the agreed weekly working hours per year (or equivalent if hours are agreed per year)."
        }
      ]
    },
    {
      "key": "sick_pay.statutory",
      "description": "Continued pay during sickness (BW 7:629)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "payer": "employer",
            "continuedPayPercent": 70,
            "maxWeeks": 104,
            "minimumWageFloorFirstWeeks": 52,
            "wageCap": "max_daily_wage_wfsv_art17"
          },
          "source": {
            "url": "https://wetten.overheid.nl/BWBR0005290/2026-01-01",
            "title": "Burgerlijk Wetboek Boek 7 (wetten.overheid.nl), versie 2026-01-01 — art. 7:629, 7:634, 7:672"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "70% of time-based wage for 104 weeks, first 52 weeks at least the statutory minimum wage; capped at the daily maximum under art. 17 Wfsv. Shorter (6 weeks) for domestic workers <4 days/week and employees over state-pension age."
        }
      ]
    },
    {
      "key": "employment.notice_period",
      "description": "Statutory notice (BW 7:672)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "terminationDate": "end_of_month",
            "employerByService": [
              {
                "minServiceYears": 0,
                "months": 1
              },
              {
                "minServiceYears": 5,
                "months": 2
              },
              {
                "minServiceYears": 10,
                "months": 3
              },
              {
                "minServiceYears": 15,
                "months": 4
              }
            ],
            "employeeMonths": 1,
            "employerAfterStatePensionAgeMonths": 1,
            "shorteningOnlyByCao": true,
            "uwvPermitDeduction": {
              "minRemainingMonths": 1
            }
          },
          "source": {
            "url": "https://wetten.overheid.nl/BWBR0005290/2026-01-01",
            "title": "Burgerlijk Wetboek Boek 7 (wetten.overheid.nl), versie 2026-01-01 — art. 7:629, 7:634, 7:672"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)"
        }
      ]
