      "key": "leave.statutory_annual_minimum",
      "description": "Annual leave (Semesterlag 1977:480, 4 §)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "days": 25,
            "dayUnit": "semesterdagar",
            "startedAfterAug31DaysThatYear": 5
          },
          "source": {
            "url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/svensk-forfattningssamling/semesterlag-1977480_sfs-1977-480/",
            "title": "Semesterlag (1977:480), 4 §"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Right to 25 days of leave each leave year; only 5 days if employment starts after 31 August of the leave year."
        }
      ]
    },
    {
      "key": "reporting.pay_transparency",
      "description": "EU Pay Transparency Directive (EU) 2023/970 — national transposition status (as verified 2026-10-18)",
      "versions": [
        {
          "effectiveFrom": "2023-06-06",
          "effectiveTo": null,
          "value": {
            "status": "draft",
            "law": "Lagrådsremiss \"Genomförande av lönetransparensdirektivet\" (15 januari 2026) — amendments to Diskrimineringslagen (2008:567)",
            "inForceFrom": null
          },
          "source": {
            "url": "https://www.regeringen.se/pressmeddelanden/2026/03/mer-tid-for-forberedelser-infor-genomforandet-av-lonetransparensdirektivet/",
            "title": "Regeringen: Mer tid för förberedelser inför genomförandet av lönetransparensdirektivet (11 mars 2026)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Government said on 2026-03-11 it intends to propose entry into force 2027-01-01 (first pay reports to DO by 2028-05-20). No act adopted; Sweden notified only pre-existing measures on EUR-Lex. Secondary sources report the government later paused the bill (26 Mar 2026) — not confirmed on regeringen.se."
        }
      ]
    }
