    {
      "key": "leave.statutory_annual_minimum",
      "description": "Statutory annual leave (Organisation of Working Time Act 1997, s. 19)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "maxWorkingWeeks": 4,
            "leaveYear": "april_to_march",
            "methods": [
              {
                "method": "hours_worked",
                "minHoursInLeaveYear": 1365,
                "entitlementWorkingWeeks": 4,
                "notAvailableIfChangedEmploymentInYear": true
              },
              {
                "method": "per_month",
                "workingWeekFraction": "1/3",
                "minHoursInCalendarMonth": 117
              },
              {
                "method": "percent_of_hours",
                "percent": 8,
                "capWorkingWeeks": 4
              }
            ],
            "useGreatestOfMethods": true,
            "unbrokenTwoWeeksAfterMonthsService": 8
          },
          "source": {
            "url": "https://www.citizensinformation.ie/en/employment/employment-rights-and-conditions/leave-and-holidays/annual-leave/",
            "title": "Citizens Information (Ireland): Annual leave (Organisation of Working Time Act 1997)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Working week = the number of days the employee usually works in a week. Modelled from 2020-01-01 (rule pre-dates)."
        }
      ]
    },
    {
      "key": "sick_pay.statutory",
      "description": "Statutory Sick Pay (Sick Leave Act 2022)",
      "versions": [
        {
          "effectiveFrom": "2024-01-01",
          "effectiveTo": null,
          "value": {
            "payer": "employer",
            "daysPerYear": 5,
            "ratePercent": 70,
            "dailyCap": {
              "amountMinor": 11000,
              "currency": "EUR"
            },
            "qualifyingServiceWeeks": 13,
            "medicalCertificateRequired": true,
            "waitingDays": 0
          },
          "source": {
            "url": "https://www.citizensinformation.ie/en/employment/employment-rights-and-conditions/leave-and-holidays/sick-leave-and-sick-pay/",
            "title": "Citizens Information (Ireland): Sick leave and sick pay (Sick Leave Act 2022)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "5 days from 1 Jan 2024 (3 days in 2023 — 2023 version not modelled as its cap was not shown on the source)."
        }
      ]
    },
    {
      "key": "employment.notice_period",
      "description": "Minimum notice by employer (Minimum Notice and Terms of Employment Act 1973, s. 4)",
      "versions": [
        {
          "effectiveFrom": "2020-01-01",
          "effectiveTo": null,
          "value": {
            "appliesTo": "employer",
            "minServiceWeeksForEntitlement": 13,
            "employerByService": [
              {
                "minServiceYears": 0,
                "weeks": 1
              },
              {
                "minServiceYears": 2,
                "weeks": 2
              },
              {
                "minServiceYears": 5,
                "weeks": 4
              },
              {
                "minServiceYears": 10,
                "weeks": 6
              },
              {
                "minServiceYears": 15,
                "weeks": 8
              }
            ]
          },
          "source": {
            "url": "https://www.irishstatutebook.ie/eli/1973/act/4/section/4/enacted/en/html",
            "title": "Minimum Notice and Terms of Employment Act 1973, s. 4 (Irish Statute Book)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Section 4 as enacted (s. 4(4) lets the Minister vary by order; no variation checked). Employee notice (s. 4(3)) not modelled. Modelled from 2020-01-01."
        }
      ]
