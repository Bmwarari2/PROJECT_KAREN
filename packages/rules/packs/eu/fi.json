  "rules": [
    {
      "key": "leave.statutory_annual_minimum",
      "description": "Vuosilomalaki 5 §: 2.5 arkipäivää per full holiday-credit month (2 if employment lasted under one year by the end of the holiday-credit year) — 30/24 days per year on a 6-day basis",
      "versions": [
        {
          "effectiveFrom": "2026-01-01",
          "effectiveTo": null,
          "value": {
            "accrualPerMonth": 2.5,
            "accrualPerMonthIfServiceUnderOneYear": 2,
            "dayUnit": "arkipaiva",
            "weekBasisDays": 6,
            "fullYearDays": 30,
            "fullYearDaysIfServiceUnderOneYear": 24,
            "roundingPartDayUp": true
          },
          "source": {
            "url": "https://www.finlex.fi/fi/laki/ajantasa/2005/20050162",
            "title": "Vuosilomalaki 162/2005 (Annual Holidays Act), 4 § ja 5 §"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "5 §: \"kaksi ja puoli arkipäivää kultakin täydeltä lomanmääräytymiskuukaudelta\"; two days if the employment has lasted less than a year by the end of the holiday-credit year; part days rounded up. Holiday-credit year (1 April – 31 March) and full-month (14 days / 35 hours) rules not modelled. Verified as the law in force on the verification date; historical effective date not researched, so effectiveFrom is set to 2026-01-01 (earlier dates resolve to the parent/none)."
        }
      ]
    },
    {
      "key": "reporting.pay_transparency",
