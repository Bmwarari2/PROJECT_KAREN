    {
      "key": "sick_pay.paid_sick_leave_accrual",
      "description": "California Healthy Workplaces, Healthy Families Act paid sick leave",
      "versions": [
        {
          "effectiveFrom": "2024-01-01",
          "effectiveTo": null,
          "value": {
            "accrual": {
              "hoursEarned": 1,
              "perHoursWorked": 30
            },
            "annualUseCap": {
              "hours": 40,
              "days": 5,
              "rule": "greater_of"
            },
            "accrualCap": {
              "hours": 80,
              "days": 10,
              "rule": "greater_of"
            },
            "frontloadAlternative": {
              "hours": 40,
              "days": 5,
              "rule": "greater_of",
              "newHireMinimums": [
                {
                  "byDay": 120,
                  "hours": 24,
                  "days": 3
                },
                {
                  "byDay": 200,
                  "hours": 40,
                  "days": 5
                }
              ]
            },
            "eligibility": {
              "minDaysWorkedInStateWithinYear": 30,
              "employmentPeriodDaysBeforeUse": 90
            },
            "localOrdinancesMayBeMoreGenerous": true
          },
          "source": {
            "url": "https://www.dir.ca.gov/dlse/Paid_Sick_Leave.htm",
            "title": "California DIR/DLSE — Paid Sick Leave"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "From 1 Jan 2024 the use cap rose from 24 hours/3 days to 40 hours/5 days. Pre-2024 version not modelled."
        }
      ]
