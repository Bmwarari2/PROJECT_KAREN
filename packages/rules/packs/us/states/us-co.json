    {
      "key": "overtime.daily",
      "description": "Colorado COMPS Order Rule 4: time and a half over 40/week, 12/workday or 12 consecutive hours (whichever pays more)",
      "versions": [
        {
          "effectiveFrom": "2024-01-01",
          "effectiveTo": null,
          "value": {
            "tiers": [
              {
                "afterHours": 12,
                "multiplier": 1.5
              }
            ],
            "consecutiveHoursThreshold": 12,
            "consecutiveMultiplier": 1.5,
            "rule": "whichever_of_weekly_daily_or_consecutive_pays_more"
          },
          "source": {
            "url": "https://cdle.colorado.gov/sites/cdle/files/info_%231_2026_comps_&_paycalc_orders_12.18.25.pdf",
            "title": "Colorado CDLE INFO #1 — Key Wage and Hour Rights (2026 COMPS & PAY CALC Orders, updated 18 Dec 2025)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Long-standing rule; in force before this date. Earlier history is not modelled — effectiveFrom is the modelling baseline, not the date the rule was enacted. Weekly 40h rule matches FLSA (inherited). Agricultural, ski, medical transport and other partial exemptions not modelled."
        }
      ]
    },
    {
      "key": "sick_pay.paid_sick_leave_accrual",
      "description": "Colorado Healthy Families and Workplaces Act accrued paid sick leave",
      "versions": [
        {
          "effectiveFrom": "2022-01-01",
          "effectiveTo": null,
          "value": {
            "accrual": {
              "hoursEarned": 1,
              "perHoursWorked": 30
            },
            "annualCapHours": 48,
            "allEmployerSizes": true
          },
          "source": {
            "url": "https://cdle.colorado.gov/dlss/labor-laws-by-topic/wage-and-hour-laws-including-paid-sick-leave",
            "title": "Colorado CDLE — Wage and Hour Laws (including Paid Sick Leave)"
          },
          "verifiedOn": "2026-10-18",
          "reviewer": "research-agent (pending legal review)",
          "notes": "Accrual requirement took effect 1 Jan 2021 for larger employers and from 1 Jan 2022 for all employers; 2021 phase not modelled. Public health emergency leave (80h) not in effect."
        }
      ]
    },
