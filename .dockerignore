.verify
.deploy
.loadtest
.lighthouse
.tmp
**/.tmp-*
apps/web/e2e/__screenshots__
apps/web/e2e/.results
apps/web/e2e/.role-views
apps/web/playwright-report
apps/web/test-results
playwright-report
test-results
infra/cdk.out
infra/gcp/staging/.terraform
**/*.tfstate
**/*.tfplan
